# Stripe Public Key (from your Stripe Dashboard)
# Go to https://dashboard.stripe.com/apikeys and copy your Publishable key (pk_test_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Postgres connection string for real accounts/sessions (auth only — course/
# enrollment/certificate data is still client-side). Create a free project at
# https://neon.tech, then copy its connection string here.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
# Keep this out of version control and never reuse it across environments.
SESSION_SECRET=

# Copy this file to .env.local (gitignored) and fill in the values above, then run:
#   npm run db:migrate   (creates the users/tokens tables)
#   npm run db:seed      (creates the 6 demo accounts used by the login page)
